<UserControl x:Class="ImageForge.Views.TopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImageForge.Views"
             mc:Ignorable="d" 
              >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"> 
            <Image></Image>
            <TextBlock Text="图像处理"  Style="{StaticResource TopText}"></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource btnStyle}" Command="{Binding OpenFileCommand}">选择文件夹</Button>
            <Button Style="{StaticResource btnStyle}" Command="{Binding StartCommand}">开始处理</Button>
            <Button Style="{StaticResource btnStyle}" Command="{Binding StopCommand}">停止全部</Button>
        </StackPanel>

        <Button Grid.Column="3" Command="{Binding  CloseCommand}" Style="{StaticResource btnStyle}" > 关闭界面</Button>
    </Grid>
</UserControl>
